{
  "name": "@dualityinstitute/opencode-ai-usage",
  "version": "0.1.0",
  "description": "Claude and ChatGPT subscription limits in the OpenCode sidebar",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": ["dist/tui.js", "README.md", "LICENSE"],
  "license": "Apache-2.0",
  "homepage": "https://github.com/duality-institute/ai_use_tracker#readme",
  "bugs": {
    "url": "https://github.com/duality-institute/ai_use_tracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duality-institute/ai_use_tracker.git"
  },
  "keywords": ["opencode", "opencode-plugin", "claude", "chatgpt", "usage"],
  "engines": {
    "opencode": ">=1.19.0 <2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "verify": "bun run check && bun run build && bun --conditions=browser --preload @opentui/solid/preload scripts/verify.tsx",
    "release:check": "bun run verify && npm publish --dry-run --ignore-scripts",
    "prepublishOnly": "bun run verify"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.0",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "1.3.14",
    "@types/node": "24.9.0",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
